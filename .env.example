DATABASE_URL="postgresql://finance:finance@localhost:5433/finance_api?schema=public"

# Must match Jwt:Secret / Jwt:Issuer / Jwt:Audience in auth-system-dotnet.
# This API only verifies access tokens; it never issues them.
JWT_SECRET="same-signing-key-as-auth-system-dotnet"
JWT_ISSUER="AuthSystem"
JWT_AUDIENCE="AuthSystem.Clients"

PORT=4000
