DATABASE_URL="postgresql://finance:finance@localhost:5433/finance_api?schema=public"

# Emisor de los access tokens (auth-system-dotnet). De aquí sale el JWKS
# (<AUTH_SERVICE_URL>/.well-known/jwks.json) con la clave pública RSA.
# Esta API solo verifica tokens; no tiene la privada y no puede emitirlos.
AUTH_SERVICE_URL="http://localhost:5073"
JWT_ISSUER="AuthSystem"
JWT_AUDIENCE="AuthSystem.Clients"

PORT=4000
